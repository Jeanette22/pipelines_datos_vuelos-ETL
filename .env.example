# Copiá este archivo a .env y ajustá los valores. .env NO se sube a Git.

# --- HDFS ---
HDFS_NAMENODE=hdfs://localhost:9000
HDFS_INGEST_DIR=/ingest

# --- Fuente de datos (ingesta) ---
DATA_BASE_URL=https://data-engineer-edvai.s3.amazonaws.com
LANDING_DIR=/home/hadoop/landing
INFORME_2021_FILE=2021-informe-ministerio.csv
INFORME_2022_FILE=202206-informe-ministerio.csv
AEROPUERTOS_FILE=aeropuertos_detalle.csv

# --- Hive ---
HIVE_DATABASE=vuelos_argentina
HIVE_VUELOS_TABLE=tabla_aero
HIVE_AEROPUERTOS_TABLE=aero_detall

# --- Transformación ---
CSV_DELIMITER=;
FECHA_DESDE=2021-01-01
FECHA_HASTA=2022-06-30

# --- Airflow (variables del scheduler) ---
ETL_REPO_DIR=/home/hadoop/pipelines_datos_vuelos-ETL
SPARK_SUBMIT_BIN=/home/hadoop/spark/bin/spark-submit
HIVE_SITE_XML=/home/hadoop/hive/conf/hive-site.xml
# Dejar vacío si Airflow y Spark están en el mismo nodo. Ej.: hadoop@172.17.0.2
SPARK_SSH_TARGET=
